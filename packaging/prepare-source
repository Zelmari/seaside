#!/usr/bin/env bash
set -euo pipefail

if (( $# < 1 || $# > 2 )); then
  printf 'Usage: %s OUTPUT_DIRECTORY [GIT_REVISION]\n' "$0" >&2
  exit 2
fi

repository=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
destination=$(realpath -m -- "$1")
revision=$(git -C "$repository" rev-parse --verify --end-of-options "${2:-HEAD}^{commit}")
if [[ $(git -C "$repository" rev-parse --is-shallow-repository) == true ]]; then
  printf 'A full Git checkout is needed to compute the candidate package version.\n' >&2
  exit 1
fi
if [[ -e $destination ]] &&
  [[ ! -d $destination || -n $(find "$destination" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
  printf 'The package staging directory must be new or empty: %s\n' "$destination" >&2
  exit 1
fi

# Read the release recipe and version from the same tree as the archive.
recipe=$(git -C "$repository" show "$revision:packaging/PKGBUILD")
meson=$(git -C "$repository" show "$revision:meson.build")
base_version=$(sed -n "s/^  version: '\([0-9][0-9.]*\)-dev',$/\1/p" <<< "$meson")
if [[ ! $base_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  ! grep -qxF 'pkgver=@PACKAGE_VERSION@' <<< "$recipe" ||
  ! grep -qF "sha256sums=('@SOURCE_SHA256@'" <<< "$recipe"; then
  printf 'Cannot read the development version or recipe markers at %s.\n' "$revision" >&2
  exit 1
fi

count=$(git -C "$repository" rev-list --count "$revision")
version="${base_version}dev.r$count.g$revision"
archive="seaside-$version.tar.gz"
parent=$(dirname -- "$destination")
mkdir -p -- "$parent"
staging=$(mktemp -d -- "$parent/.seaside-package.XXXXXXXX")
trap 'rm -rf -- "$staging"' EXIT

git -C "$repository" archive --format=tar --prefix="seaside-$version/" "$revision" |
  gzip -n > "$staging/$archive"
read -r digest _ < <(sha256sum -- "$staging/$archive")
sed -e "s/@PACKAGE_VERSION@/$version/g" -e "s/@SOURCE_SHA256@/$digest/g" \
  <<< "$recipe" > "$staging/PKGBUILD"

# Replacing an empty directory succeeds. A concurrent writer that populated it
# makes publication fail without overwriting its files.
mv -T -- "$staging" "$destination"
printf 'Staged Seaside %s at %s\n' "$version" "$destination"
