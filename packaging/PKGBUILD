# Stage this recipe and its exact source archive with packaging/prepare-source.
pkgname=seaside
pkgver=@PACKAGE_VERSION@
pkgrel=1
pkgdesc='TTY-launched Wayland compositor for Arch Linux'
arch=('x86_64')
url='https://github.com/Zelmari/seaside'
license=('MIT')
depends=(
  'bash' 'cairo' 'foot' 'glib2' 'glibc' 'libdrm' 'libgcc' 'libinput'
  'libjpeg-turbo' 'libpipewire' 'libpng' 'libstdc++' 'libwebp' 'libxau'
  'libxkbcommon' 'mesa' 'pango' 'pipewire' 'pipewire-audio' 'pipewire-pulse'
  'pixman' 'polkit' 'rtkit' 'systemd' 'systemd-libs' 'tomlplusplus>=3.4.0' 'tomlplusplus<3.5.0'
  'ttf-dejavu' 'wayland' 'wireplumber' 'wlroots0.20>=0.20.2' 'wlroots0.20<0.21.0'
  'wofi' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk' 'xdg-desktop-portal-wlr>=0.8.4'
  'xorg-xwayland' 'xwayland-satellite'
)
# Meson configures the development test targets alongside the installed targets.
makedepends=(
  'dbus' 'gtest>=1.14.0' 'libxcb' 'meson>=1.3.0' 'ninja'
  'nlohmann-json>=3.11.0' 'pkgconf' 'python' 'wayland-protocols' 'wlr-protocols'
)
optdepends=('wf-recorder: command-line recording of an output')
backup=('etc/xdg/xdg-desktop-portal-wlr/Seaside')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  arch-meson --sysconfdir=/etc . build
  meson compile -C build seaside seasidectl
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  # Check the staged payload here. The full harness has its own runtime
  # environment, and the installed TTY trial needs a real seat.
  meson test -C build --no-rebuild --print-errorlogs --suite part10
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
