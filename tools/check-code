#!/usr/bin/env python3
"""Check migrated core formatting and analyze the actual project compile commands."""

import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import json
import os
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent


def read_limit(path):
    try:
        return path.read_text().strip()
    except OSError:
        return ''


def analyzer_workers(proc=Path('/proc'), cgroup_root=Path('/sys/fs/cgroup')):
    cpus = len(os.sched_getaffinity(0))
    gib = 1024 ** 3
    available = next((int(line.split()[1]) * 1024
                      for line in read_limit(proc / 'meminfo').splitlines()
                      if line.startswith('MemAvailable:')), gib)
    # A delegated cgroup can inherit tighter limits from any ancestor.
    membership = next((line[3:] for line in read_limit(proc / 'self/cgroup').splitlines()
                       if line.startswith('0::')), '/')
    group = cgroup_root / membership.lstrip('/')
    while group.is_relative_to(cgroup_root):
        cpu = read_limit(group / 'cpu.max').split()
        if len(cpu) == 2 and cpu[0].isdigit() and int(cpu[1]) > 0:
            cpus = min(cpus, int(cpu[0]) // int(cpu[1]))
        usage = read_limit(group / 'memory.current')
        if usage.isdigit():
            for name in ('memory.high', 'memory.max'):
                limit = read_limit(group / name)
                if limit.isdigit():
                    available = min(available, int(limit) - int(usage))
        group = group.parent
    # Leave half a GiB free and allow one GiB per analyzer, up to four.
    return max(1, min(4, cpus, (available - gib // 2) // gib))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-dir', type=Path, default=ROOT / 'build')
    args = parser.parse_args()
    build_dir = args.build_dir.resolve()
    formatted = sorted(
        path for directory in ('src', 'tests/unit', 'tests/integration', 'tests/probe', 'tests/hardware', 'tools')
        for path in (ROOT / directory).rglob('*')
        if path.suffix in ('.c', '.h', '.cpp', '.hpp')
    )
    try:
        if not formatted:
            raise ValueError('No source files found for formatting check')
        commands = json.loads((build_dir / 'compile_commands.json').read_text())
        if not isinstance(commands, list) or not commands:
            raise ValueError('Compilation database must contain project translation units')
        sources = set()
        for row in commands:
            if (not isinstance(row, dict) or not isinstance(row.get('directory'), str)
                    or not isinstance(row.get('file'), str) or not row['file']):
                raise ValueError('Invalid compilation database entry')
            invocation = row.get('arguments', row.get('command'))
            if not invocation or not isinstance(invocation, (str, list)):
                raise ValueError('Compilation database entry has no compiler invocation')
            if isinstance(invocation, list) and any(not isinstance(arg, str) for arg in invocation):
                raise ValueError('Invalid compiler argument list')
            source = (Path(row['directory']) / row['file']).resolve()
            if source.is_relative_to(ROOT) and not source.is_relative_to(build_dir):
                if source.suffix in ('.c', '.cpp', '.cc', '.cxx'):
                    sources.add(source)
        if not sources:
            raise ValueError('Compilation database contains no applicable project translation units')
        sources = sorted(sources)
        def run_check(command):
            print(f"Checking: {command[0]} {command[-1]}", flush=True)
            try:
                return subprocess.run(command, cwd=ROOT, timeout=60, check=False).returncode
            except (OSError, subprocess.TimeoutExpired) as error:
                print(f'Code check failed: {error}', file=sys.stderr)
                return 1
        if run_check(['clang-format', '--dry-run', '--Werror', *map(str, formatted)]):
            return 1
        # Independent translation units can be analyzed concurrently. Limit the
        # process count to keep analyzer memory/CPU bounded on development guests.
        failed = False
        workers = analyzer_workers()
        print(f'Analyzing {len(sources)} sources with {workers} worker(s)', flush=True)
        with ThreadPoolExecutor(max_workers=workers) as executor:
            futures = [executor.submit(run_check, ['clang-tidy', '--quiet', '-p', str(build_dir), str(path)])
                       for path in sources]
            for future in as_completed(futures):
                if not future.cancelled() and future.result():
                    failed = True
                    for pending in futures:
                        pending.cancel()
        if failed:
            return 1
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        print(f'Code checks unavailable or failed: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
