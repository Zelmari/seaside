def gtest_environment_override(key: str) -> bool:
    return key.startswith("GTEST_") or key in FORBIDDEN_GTEST_ENV


class InterruptedRun(BaseException):
    def __init__(self, signum: int):
        self.signum = signum


def process_identity(pid: int) -> tuple[int, str] | None:
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()
        return int(fields[19]), fields[0]
    except (OSError, ValueError, IndexError):
        return None


def process_parent(pid: int) -> int | None:
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()
        return int(fields[1])
    except (OSError, ValueError, IndexError):
        return None


def child_pids(pid: int) -> list[int]:
    # Linux attributes children to the thread that forked, not necessarily the
    # thread-group leader. Worker-thread compilers/tests must remain supervised.
    children = set()
    try:
        threads = list(Path(f"/proc/{pid}/task").iterdir())
    except OSError:
        return []
    for thread in threads:
        try:
            children.update(int(value) for value in (thread / "children").read_text().split())
        except (OSError, ValueError):
            # Threads can disappear between directory enumeration and reading.
            continue
    return sorted(children)


class OwnedProcessTree:
    """Exclusive serial ownership, including descendants orphaned by Meson tests."""

    def __init__(self):
        existing = child_pids(os.getpid())
        if existing:
            raise OSError("Exclusive command supervision requires no pre-existing children")
        if not hasattr(os, "pidfd_open") or not hasattr(signal, "pidfd_send_signal"):
            raise OSError("PID-safe command supervision requires Linux pidfd support")
        self.libc = ctypes.CDLL(None, use_errno=True)
        self.previous = ctypes.c_int()
        if self.libc.prctl(37, ctypes.byref(self.previous), 0, 0, 0) != 0:
            raise OSError(ctypes.get_errno(), "Cannot inspect child-subreaper state")
        self.owned = {}
        self.pidfds = {}
        self.errors = []
        self.root = None
        # A process-local subreaper keeps an orphan in our ancestry even when
        # a short-lived test leader exits between observations or starts a session.
        if self.libc.prctl(36, 1, 0, 0, 0) != 0:
            raise OSError(ctypes.get_errno(), "Cannot enable child-subreaper cleanup")

    def refresh(self) -> None:
        # Long builds can create thousands of short-lived descendants. Retain
        # pidfds only while their original process can still receive signals.
        for pid, started in list(self.owned.items()):
            identity = process_identity(pid)
            retired = identity is None or identity[0] != started
            if retired or identity[1] == "Z":
                descriptor = self.pidfds.pop(pid, None)
                if descriptor is not None:
                    os.close(descriptor)
            if retired:
                del self.owned[pid]
                if self.root == pid:
                    self.root = None
        pending = [(pid, None) for pid in self.owned]
        if self.root is not None:
            pending.append((self.root, os.getpid()))
        pending.extend((pid, os.getpid()) for pid in child_pids(os.getpid()))
        visited = set()
        while pending:
            pid, expected_parent = pending.pop()
            if pid in visited:
                continue
            visited.add(pid)
            identity = process_identity(pid)
            if identity is None:
                continue
            prior = self.owned.get(pid)
            if prior is not None and identity[0] != prior:
                continue
            if prior is None and not self.parent_matches(pid, expected_parent):
                continue
            self.owned[pid] = identity[0]
            if identity[1] == "Z":
                continue
            if pid not in self.pidfds:
                try:
                    descriptor = os.pidfd_open(pid, 0)
                except ProcessLookupError:
                    continue
                except OSError as error:
                    self.record_error(f"Cannot pin owned process {pid}: {error}")
                    continue
                confirmed = process_identity(pid)
                if (confirmed is None or confirmed[0] != identity[0]
                        or (prior is None and not self.parent_matches(pid, expected_parent))):
                    os.close(descriptor)
                    continue
                self.pidfds[pid] = descriptor
            self.owned[pid] = identity[0]
            pending.extend((child, pid) for child in child_pids(pid))

    def parent_matches(self, pid: int, expected_parent: int | None) -> bool:
        parent = process_parent(pid)
        if parent == os.getpid():
            return True  # Includes descendants adopted by our subreaper.
        if parent != expected_parent or parent not in self.owned:
            return False
        identity = process_identity(parent)
        return identity is not None and identity[0] == self.owned[parent]

    def record_error(self, message: str) -> None:
        if message not in self.errors and len(self.errors) < 16:
            self.errors.append(message)

    def signal(self, signum: int) -> None:
        self.refresh()
        for pid, descriptor in self.pidfds.items():
            try:
                # A pidfd still denotes the original process after numeric PID
                # reuse. Never fall back to signaling an unverified PID/PGID.
                signal.pidfd_send_signal(descriptor, signum)
            except ProcessLookupError:
                pass
            except OSError as error:
                self.record_error(f"Cannot signal owned process {pid}: {error}")

    def alive(self) -> bool:
        self.refresh()
        return any(
            (identity := process_identity(pid)) is not None
            and identity[0] == started and identity[1] != "Z"
            for pid, started in self.owned.items()
        )

    def close(self) -> None:
        # A child can reparent and become a zombie after the final liveness scan.
        self.refresh()
        for pid, started in self.owned.items():
            identity = process_identity(pid)
            if identity is not None and identity[0] == started:
                try:
                    os.waitpid(pid, os.WNOHANG)
                except ChildProcessError:
                    pass
        for descriptor in self.pidfds.values():
            os.close(descriptor)
        self.pidfds.clear()
        if self.libc.prctl(36, self.previous.value, 0, 0, 0) != 0:
            raise OSError(ctypes.get_errno(), "Cannot restore child-subreaper state")
        if self.errors:
            raise OSError("; ".join(self.errors))


class BoundedOutput:
    def __init__(self, limit: int):
        self.limit = limit
        self.total = 0
        self.head = bytearray()
        self.tail = bytearray()

    def append(self, chunk: bytes) -> None:
        self.total += len(chunk)
        head_size = self.limit // 2
        take = min(len(chunk), head_size - len(self.head))
        self.head.extend(chunk[:take])
        self.tail.extend(chunk[take:])
        tail_size = self.limit - head_size
        if len(self.tail) > tail_size:
            del self.tail[: len(self.tail) - tail_size]

    def bytes(self) -> bytes:
        if self.total <= self.limit:
            return bytes(self.head + self.tail)
        marker = b"\n[output truncated]\n"
        if self.limit < len(marker):
            return marker[: self.limit]
        remaining = self.limit - len(marker)
        head_size = remaining // 2
        tail_size = remaining - head_size
        tail = bytes(self.tail[-tail_size:]) if tail_size else b""
        return bytes(self.head[:head_size]) + marker + tail


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _stop_owned_processes(process: subprocess.Popen, grace: float, tree: OwnedProcessTree) -> str | None:
    tree.signal(signal.SIGTERM)
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline:
        if process.poll() is not None and not tree.alive():
            break
        time.sleep(0.01)
    if process.poll() is None or tree.alive():
        tree.signal(signal.SIGKILL)
    wait_error = None
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        wait_error = "Process did not exit after SIGKILL"
    deadline = time.monotonic() + 1
    while tree.alive() and time.monotonic() < deadline:
        tree.signal(signal.SIGKILL)
        time.sleep(0.01)
    if tree.alive():
        wait_error = "Owned descendant remained alive after SIGKILL"
    errors = [*tree.errors, *([wait_error] if wait_error else [])]
    return "; ".join(errors) if errors else None


def run_command(
    command: list[str],
    *,
    cwd: Path,
    log_path: Path,
    timeout: float,
    log_limit: int = 1024 * 1024,
    env: dict[str, str] | None = None,
    terminate_grace: float = 2.0,
) -> dict:
    """Supervise one command exclusively on the main thread, without a shell.

    The standalone runner creates subprocesses serially. Embedding this helper
    alongside other child owners is unsupported and blocks before starting work.
    No independent code may create children while the command is active.
    """
    if not command or any(not isinstance(arg, str) for arg in command):
        raise ValueError("command must be a nonempty string argument list")
    if not math.isfinite(timeout) or timeout <= 0:
        raise ValueError("timeout must be finite and positive")
    if log_limit < 1 or terminate_grace <= 0:
        raise ValueError("log limit and termination grace must be positive")
    log_path.parent.mkdir(parents=True, exist_ok=True)
    output = BoundedOutput(log_limit)
    started = time.monotonic()
    result = {
        "command": command,
        "cwd": str(cwd),
        "started_at": utc_now(),
        "status": "blocked",
        "returncode": None,
        "timed_out": False,
        "interrupted_signal": None,
        "error": None,
        "cleanup_error": None,
        "log": str(log_path),
    }
    process = None
    tree = None
    selector = selectors.DefaultSelector()
    try:
        tree = OwnedProcessTree()
        process = subprocess.Popen(
            command,
            cwd=cwd,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        tree.root = process.pid
        os.set_blocking(process.stdout.fileno(), False)
        selector.register(process.stdout, selectors.EVENT_READ)
        while selector.get_map() or process.poll() is None:
            tree.refresh()
            remaining = timeout - (time.monotonic() - started)
            if remaining <= 0:
                result["timed_out"] = True
                result["error"] = f"Command exceeded its {timeout:g}s deadline"
                break
            for key, _ in selector.select(min(remaining, 0.05)):
                chunk = os.read(key.fd, 65536)
                if chunk:
                    output.append(chunk)
                else:
                    selector.unregister(key.fileobj)
        result["status"] = "fail" if result["timed_out"] else "pass"
    except (KeyboardInterrupt, InterruptedRun) as error:
        result["interrupted_signal"] = (
            error.signum if isinstance(error, InterruptedRun) else signal.SIGINT
        )
        result["error"] = "Run interrupted"
    except OSError as error:
        result["error"] = str(error)
    finally:
        cleanup_handlers = {}

        def defer_interrupt(signum, _frame):
            result["interrupted_signal"] = signum
            result["error"] = "Run interrupted"
            result["status"] = "blocked"

        for signum in (signal.SIGINT, signal.SIGTERM):
            cleanup_handlers[signum] = signal.signal(signum, defer_interrupt)
        if process is not None:
            result["cleanup_error"] = _stop_owned_processes(process, terminate_grace, tree)
            drain_until = time.monotonic() + 0.2
            while selector.get_map() and time.monotonic() < drain_until:
                for key, _ in selector.select(0.01):
                    chunk = os.read(key.fd, 65536)
                    if chunk:
                        output.append(chunk)
                    else:
                        selector.unregister(key.fileobj)
            if selector.get_map() and result["cleanup_error"] is None:
                result["cleanup_error"] = "Output pipe remained open after process-group cleanup"
            process.stdout.close()
            result["returncode"] = process.returncode
            if result["cleanup_error"]:
                result["status"] = "fail"
            elif result["error"] is None:
                result["status"] = (
                    "pass" if process.returncode == 0 else
                    "skip" if process.returncode == 77 else "fail"
                )
        if tree is not None:
            try:
                tree.close()
            except OSError as error:
                result["cleanup_error"] = str(error)
                result["status"] = "fail"
        selector.close()
        retained = output.bytes()
        log_path.write_bytes(retained)
        result.update(
            finished_at=utc_now(),
            duration_seconds=round(time.monotonic() - started, 6),
            output_bytes=output.total,
            log_bytes=len(retained),
            log_truncated=output.total > log_limit,
        )
        for signum, handler in cleanup_handlers.items():
            signal.signal(signum, handler)
    return result


def environment_facts() -> dict:
    try:
        release = platform.freedesktop_os_release()
    except OSError:
        release = {}
    kernel = platform.uname()
    wsl = "microsoft" in kernel.release.lower() or "wsl" in kernel.release.lower()
    return {
        "classification": "arch-wsl2" if wsl and release.get("ID") == "arch" else
                          "wsl" if wsl else f"{release.get('ID', 'unknown')}-linux",
        "os_release": {key: release[key] for key in ("ID", "NAME", "VERSION_ID", "BUILD_ID") if key in release},
        "kernel": kernel.release,
        "machine": kernel.machine,
        "python": platform.python_version(),
        "physical_gpu_qualification": "not_established",
        "tty_session_qualification": "not_tested_by_this_runner",
    }


def open_regular_result(path: Path):
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
    source = os.fdopen(descriptor, "rb")
    if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
        source.close()
        raise ValueError(f"Result must be a regular file: {path.name}")
    return source


def read_bounded(path: Path, limit: int) -> bytes:
    with open_regular_result(path) as source:
        value = source.read(limit + 1)
    if len(value) > limit:
        raise ValueError(f"Result file exceeds {limit} bytes: {path.name}")
    return value


def load_test_manifest(build_dir: Path, suites: list[str]) -> list[dict]:
    rows = json.loads(read_bounded(build_dir / "meson-info/intro-tests.json", 2 * 1024 * 1024))
    if not isinstance(rows, list) or not rows or len(rows) > 10000:
        raise ValueError("Meson test discovery must produce a nonempty bounded array")
    selected = []
    names = set()
    gtest_names = set()
    for row in rows:
        if not isinstance(row, dict):
            raise ValueError("Invalid discovered Meson test")
        name, command, env, membership = (row.get(key) for key in ("name", "cmd", "env", "suite"))
        if (not isinstance(name, str) or not name or name in names
                or not isinstance(command, list) or not command
                or any(not isinstance(arg, str) for arg in command)
                or not isinstance(env, dict) or any(not isinstance(key, str) or not isinstance(value, str)
                                                     for key, value in env.items())
                or not isinstance(membership, list)
                or any(not isinstance(suite, str) for suite in membership)):
            raise ValueError("Invalid or duplicate discovered Meson test")
        names.add(name)
        if suites and not any(
            fnmatch.fnmatchcase(value, requested) or fnmatch.fnmatchcase(value.split(":", 1)[-1], requested)
            for requested in suites for value in membership
        ):
            continue
        part = int(env.get("SEASIDE_TEST_PART", "1"))
        if not 1 <= part <= 10:
            raise ValueError("Invalid test part marker")
        requirements = env.get("SEASIDE_REQUIREMENTS", "12.2b")
        if not isinstance(requirements, str) or any(not value.strip() for value in requirements.split(",")):
            raise ValueError("Invalid test requirement marker")
        if env.get("SEASIDE_GTEST", "0") not in ("0", "1"):
            raise ValueError("Invalid GoogleTest marker")
        gtest_name = Path(command[0]).name if env.get("SEASIDE_GTEST") == "1" else None
        if gtest_name:
            if any(gtest_environment_override(key) for key in env) or any(
                argument.startswith("--gtest_") for argument in command[1:]
            ):
                raise ValueError("GoogleTest filters/output/sharding flags must not override run-owned discovery")
            if gtest_name in gtest_names:
                raise ValueError("GoogleTest executables need unique XML output basenames")
            gtest_names.add(gtest_name)
        working_directory = row.get("workdir") or str(build_dir)
        if not isinstance(working_directory, str):
            raise ValueError("Invalid discovered test working directory")
        selected.append({
            "name": name, "part": part, "requirement_sections": [value.strip() for value in requirements.split(",")],
            "command": command, "gtest_name": gtest_name,
            "environment": env, "working_directory": working_directory,
        })
    if not selected:
        raise ValueError("No tests match the requested suites; an empty discovery is not a pass")
    return selected


def gtest_document(path: Path):
    # Decode before looking for declarations. A byte-pattern check alone lets
    # UTF-16/32 documents hide entity declarations behind embedded zero bytes.
    document = read_bounded(path, 2 * 1024 * 1024).decode("utf-8-sig")
    declaration = re.match(r'\s*<\?xml\b[^?]*\?>', document)
    if declaration:
        encoding = re.search(r'''\bencoding\s*=\s*(['"])(.*?)\1''', declaration.group())
        if encoding and encoding.group(2).lower() not in ("utf-8", "utf8"):
            raise ValueError("GoogleTest XML must use UTF-8")
    if "\x00" in document or "<!DOCTYPE" in document.upper() or "<!ENTITY" in document.upper():
        raise ValueError("GoogleTest XML must not contain document types/entities")
    root = ET.fromstring(document)
    if root.tag != "testsuites":
        raise ValueError("Invalid GoogleTest XML root")
    return root


def disabled_gtest_name(classname: str, name: str) -> bool:
    return any(fnmatch.fnmatchcase(value, pattern) for value in (classname, name)
               for pattern in ("DISABLED_*", "*/DISABLED_*"))


def validate_gtest_counts(node, counts: dict, *, require_tests=False) -> None:
    for attribute, observed in counts.items():
        if attribute in node.attrib:
            if int(node.get(attribute)) != observed:
                raise ValueError(f"Inconsistent GoogleTest {attribute} count")
        elif attribute == "tests" and require_tests:
            raise ValueError("Missing GoogleTest tests count")


def discover_gtest_cases(path: Path) -> dict[str, bool]:
    root = gtest_document(path)
    cases = {}
    for suite in root.findall("testsuite"):
        classname = suite.get("name")
        entries = suite.findall("testcase")
        validate_gtest_counts(suite, {"tests": len(entries)})
        for entry in entries:
            name = entry.get("name")
            if not classname or not name or len(classname) + len(name) > 2048:
                raise ValueError("Invalid discovered GoogleTest case identity")
            identity = f"{classname}.{name}"
            if identity in cases:
                raise ValueError("Duplicate discovered GoogleTest case identity")
            cases[identity] = disabled_gtest_name(classname, name)
    if not cases or len(cases) > 10000:
        raise ValueError("GoogleTest case discovery must be nonempty and bounded")
    validate_gtest_counts(root, {"tests": len(cases)}, require_tests=True)
    return cases


def parse_gtest_results(path: Path, parent: dict, log_limit: int,
                        expected_cases: dict[str, bool] | None = None) -> list[dict]:
    root = gtest_document(path)
    entries = root.findall("./testsuite/testcase")
    if not entries or len(entries) > 10000 or int(root.get("tests", "-1")) != len(entries):
        raise ValueError("GoogleTest case discovery/count is empty or inconsistent")
    cases = []
    names = set()
    totals = Counter()
    for entry in entries:
        name, classname = entry.get("name"), entry.get("classname")
        if not name or not classname or len(name) + len(classname) > 2048:
            raise ValueError("Invalid GoogleTest case identity")
        identity = f"{classname}.{name}"
        if identity in names:
            raise ValueError("Duplicate GoogleTest case identity")
        names.add(identity)
        failures = entry.findall("failure")
        errors = entry.findall("error")
        skipped = entry.findall("skipped")
        state, outcome = entry.get("status"), entry.get("result")
        if state not in ("run", "notrun") or outcome not in ("completed", "suppressed", "skipped"):
            raise ValueError("Invalid GoogleTest case outcome")
        if (state == "notrun") != (outcome == "suppressed"):
            raise ValueError("Inconsistent GoogleTest case execution state")
        if expected_cases is not None and (identity not in expected_cases or
                                           (state == "notrun" and not expected_cases[identity])):
            raise ValueError("Unexpected or suppressed active GoogleTest case")
        status = "fail" if failures or errors else "skip" if skipped or state == "notrun" or outcome != "completed" else "pass"
        duration = float(entry.get("time", "0"))
        if not math.isfinite(duration) or duration < 0:
            raise ValueError("Invalid GoogleTest case duration")
        diagnostic = BoundedOutput(min(log_limit, 4096))
        for node in [*failures, *errors, *skipped]:
            diagnostic.append((node.get("message", "") + "\n" + (node.text or "")).encode("utf-8", errors="replace"))
        cases.append({
            "test_id": f"{parent['test_id']}::{identity}", "case_name": identity,
            "part": parent["part"], "requirement_sections": parent["requirement_sections"],
            "status": status, "duration_seconds": duration, "log": parent["log"],
            "reason": diagnostic.bytes().decode("utf-8", errors="replace") if diagnostic.total else
                      "Disabled or skipped GoogleTest case" if status == "skip" else None,
        })
    for suite in root.findall("testsuite"):
        suite_counts = Counter(tests=0, failures=0, errors=0, disabled=0, skipped=0)
        for entry in suite.findall("testcase"):
            suite_counts["tests"] += 1
            suite_counts["failures"] += bool(entry.findall("failure"))
            suite_counts["errors"] += bool(entry.findall("error"))
            suite_counts["disabled"] += disabled_gtest_name(entry.get("classname", ""), entry.get("name", ""))
            suite_counts["skipped"] += not (entry.findall("failure") or entry.findall("error")) and (
                bool(entry.findall("skipped")) or entry.get("result") == "skipped")
        validate_gtest_counts(suite, suite_counts)
        totals.update(suite_counts)
    validate_gtest_counts(root, totals, require_tests=True)
    if expected_cases is not None and names != set(expected_cases):
        raise ValueError("Executed GoogleTest case identities differ from independent discovery")
    return cases


def collection_failure(test_id: str, reason: str, metadata: dict | None = None) -> dict:
    metadata = metadata or {}
    return {
        "test_id": test_id, "part": metadata.get("part", 0),
        "requirement_sections": metadata.get("requirement_sections", ["12.2b"]),
        "status": "blocked", "reason": reason, "log": None,
    }


def prepare_gtest_discovery(manifest: list[dict], run_dir: Path, child_env: dict,
                            execute) -> list[dict]:
    directory = run_dir / "gtest-discovery"
    directory.mkdir(mode=0o700)
    for index, item in enumerate(manifest):
        if not item.get("gtest_name"):
            continue
        path = directory / (item["gtest_name"] + ".xml")
        discovery_env = child_env.copy()
        discovery_env.update(item.get("environment", {}))
        discovery_env["GTEST_OUTPUT"] = "xml:" + str(path)
        observed = execute(f"discover-gtest-{index + 1}",
                           [*item["command"], "--gtest_list_tests"],
                           env_override=discovery_env,
                           cwd_override=Path(item.get("working_directory", run_dir)))
        if observed["status"] != "pass":
            return [collection_failure(item["name"] + "-case-discovery",
                                       "Independent GoogleTest discovery did not pass", item)]
        try:
            item["expected_cases"] = discover_gtest_cases(path)
        except (OSError, ValueError, UnicodeError, ET.ParseError) as error:
            return [collection_failure(item["name"] + "-case-discovery", str(error), item)]
    return []


def parse_meson_results(path: Path, run_dir: Path, log_limit: int,
                        expected_tests: list[dict] | None = None) -> list[dict]:
    results = []
    discovered = set()
    matched = set()
    total_bytes = 0
    try:
        with open_regular_result(path) as source:
            while line := source.readline(2 * 1024 * 1024 + 1):
                total_bytes += len(line)
                if len(line) > 2 * 1024 * 1024 or len(results) >= 10000 or total_bytes > 32 * 1024 * 1024:
                    raise ValueError("Meson results exceed byte/record/count limits")
                row = json.loads(line)
                if not isinstance(row, dict) or not isinstance(row.get("name"), str) or not row["name"]:
                    raise ValueError("Invalid Meson test-result object")
                if row["name"] in discovered:
                    raise ValueError("Duplicate Meson test result")
                discovered.add(row["name"])
                metadata = None
                if expected_tests is not None:
                    matches = [item for item in expected_tests
                               if row["name"] == item["name"] or row["name"].endswith(":" + item["name"])]
                    if len(matches) != 1:
                        raise ValueError("Meson result does not match exactly one discovered test")
                    metadata = matches[0]
                    if metadata["name"] in matched:
                        raise ValueError("Duplicate result for discovered Meson test")
                    matched.add(metadata["name"])
                metadata = metadata or {"part": 1, "requirement_sections": ["12.2b"]}
                duration = row.get("duration", 0)
                returncode = row.get("returncode")
                command = row.get("command")
                if (not isinstance(duration, (int, float)) or isinstance(duration, bool)
                        or not math.isfinite(duration) or duration < 0
                        or (returncode is not None and (not isinstance(returncode, int) or isinstance(returncode, bool)))
                        or (command is not None and (not isinstance(command, list) or not command
                                                    or any(not isinstance(arg, str) for arg in command)))):
                    raise ValueError("Invalid Meson execution metadata")
                outcome = row.get("result")
                if not isinstance(outcome, str):
                    raise ValueError("Invalid Meson outcome")
                status = {
                    "OK": "pass", "EXPECTEDFAIL": "pass",
                    "SKIP": "skip", "IGNORED": "skip", "INTERRUPT": "blocked",
                    "FAIL": "fail", "ERROR": "fail", "TIMEOUT": "fail",
                    "UNEXPECTEDPASS": "fail",
                }.get(outcome, "blocked")
                if returncode is not None and ((outcome == "OK" and returncode != 0) or
                                                (outcome == "EXPECTEDFAIL" and returncode == 0)):
                    raise ValueError("Meson outcome disagrees with recorded process exit status")
                log = BoundedOutput(log_limit)
                for field in ("stdout", "stderr"):
                    value = row.get(field, "")
                    if not isinstance(value, str):
                        raise ValueError(f"Invalid Meson {field}")
                    log.append(value.encode("utf-8", errors="replace"))
                log_path = run_dir / f"test-{len(results) + 1:03d}.log"
                log_path.write_bytes(log.bytes())
                result = {
                    "test_id": row["name"], "part": metadata["part"],
                    "requirement_sections": metadata["requirement_sections"],
                    "status": status, "meson_result": outcome,
                    "command": row.get("command"), "returncode": row.get("returncode"),
                    "duration_seconds": row.get("duration"), "log": str(log_path),
                    "log_truncated": log.total > log_limit,
                    "reason": log.bytes().decode("utf-8", errors="replace")[:512] if status != "pass" else None,
                }
                if metadata.get("gtest_name"):
                    try:
                        result["cases"] = parse_gtest_results(
                            run_dir / "gtest" / (metadata["gtest_name"] + ".xml"), result, log_limit,
                            metadata.get("expected_cases"))
                        case_states = {case["status"] for case in result["cases"]}
                        if "fail" in case_states:
                            result["status"] = "fail"
                        elif "pass" not in case_states and status == "pass":
                            result["status"] = "blocked"
                            result["reason"] = "GoogleTest executed no passing cases"
                    except (OSError, ValueError, UnicodeError, ET.ParseError) as error:
                        result["cases"] = []
                        result["collection_error"] = str(error)
                        result["reason"] = f"GoogleTest case collection failed: {error}"
                        if status != "fail":
                            result["status"] = "blocked"
                results.append(result)
    except (OSError, ValueError, UnicodeError) as error:
        results.append(collection_failure("meson-result-collection", str(error)))
    if expected_tests is not None:
        for item in expected_tests:
            if not any(name == item["name"] or name.endswith(":" + item["name"]) for name in discovered):
                results.append(collection_failure(item["name"], "Discovered test produced no Meson result", item))
    if not results:
        results.append(collection_failure("meson-test-discovery", "No Meson test results were produced; an empty suite is not a pass"))
    return results


def retain_meson_logs(run_dir: Path, log_limit: int) -> list[dict]:
    artifacts = []
    paths = [run_dir / f"meson.{suffix}" for suffix in ("json", "txt", "junit.xml")]
    paths.extend(sorted((run_dir / "gtest").glob("*.xml")))
    paths.extend(sorted((run_dir / "gtest-discovery").glob("*.xml")))
    for path in paths:
        if not path.exists() and not path.is_symlink():
            continue
        try:
            with open_regular_result(path) as source:
                size = os.fstat(source.fileno()).st_size
                output = BoundedOutput(log_limit)
                output.append(source.read(log_limit))
                if size > log_limit:
                    source.seek(max(0, size - log_limit))
                    output.append(source.read(log_limit))
                    output.total = size
        except (OSError, ValueError) as error:
            artifacts.append({"path": str(path), "error": str(error), "truncated": False})
            continue
        truncated = size > log_limit
        if truncated:
            # A truncated JSON/XML file is evidence, not a parseable result file.
            retained = path.with_name(path.name + ".truncated.log")
            retained.write_bytes(output.bytes())
            path.unlink()
        else:
            retained = path
        artifacts.append({"path": str(retained), "bytes": size, "truncated": truncated})
    return artifacts


def write_report(run_dir: Path, report: dict) -> None:
    report["counts"] = {status: 0 for status in ("pass", "fail", "skip", "blocked")}
    report["counts"].update(Counter(row["status"] for row in report["tests"]))
    command_states = {row["status"] for row in report["commands"]}
    if any(row.get("cleanup_error") for row in report["commands"]):
        command_states.add("fail")
    test_states = {row["status"] for row in report["tests"]}
    if any(row["status"] == "skip" and (row.get("id") != "test" or "pass" in test_states)
           for row in report["commands"]):
        command_states.add("fail")
    if "fail" in command_states or "fail" in test_states:
        report["status"] = "fail"
    elif "blocked" in command_states or "blocked" in test_states or "pass" not in test_states:
        report["status"] = "blocked"
    else:
        report["status"] = "pass"
    report["software_status"] = report["status"]
    parts = sorted(set(report.get("parts", [])) | {row.get("part", 1) for row in report["tests"] if row.get("part", 1) > 0})
    report["parts"] = parts
    report["part"] = parts[0] if len(parts) == 1 else None
    report["case_counts"] = {status: 0 for status in ("pass", "fail", "skip", "blocked")}
    report["case_counts"].update(Counter(case["status"] for row in report["tests"] for case in row.get("cases", [])))
    report["part_results"] = {}
    for part in parts:
        rows = [row for row in report["tests"] if row.get("part", 1) == part]
        states = {row["status"] for row in rows} | {
            row["status"] for row in report["tests"] if row.get("part") == 0
        }
        software = "fail" if "fail" in command_states or "fail" in states else (
            "blocked" if "blocked" in command_states or "blocked" in states or "pass" not in states else "pass")
        report["part_results"][str(part)] = {
            "software_status": software,
            "counts": dict(Counter(row["status"] for row in rows)),
            "qualification": PART_QUALIFICATION.get(
                part, "software_evidence_only_designated_vm_qualification_not_established"),
        }
    report["part1_qualification"] = "pending_arch_vm_drm_and_interactive_checks"
    report["pending_checks"] = [
        {"test_id": row["test_id"], "status": row["status"], "reason": row.get("reason")}
        for row in [*report["tests"], *(case for test in report["tests"] for case in test.get("cases", []))]
        if row["status"] in ("skip", "blocked")
    ]
    report["finished_at"] = utc_now()
    temporary = run_dir / "summary.json.tmp"
    temporary.write_text(json.dumps(report, indent=2, allow_nan=False) + "\n")
    temporary.replace(run_dir / "summary.json")
    lines = [
        f"Seaside software checks: {report['software_status'].upper()}",
        "Parts exercised: " + ", ".join(map(str, parts)),
        "Part 1 qualification remains PENDING Arch VM DRM and interactive checks.",
        f"Environment: {report['environment']['classification']} ({report['environment']['kernel']})",
        "This run does not establish physical GPU or real TTY-session qualification.",
        "Tests: " + ", ".join(f"{count} {status}" for status, count in report["counts"].items()),
        "GoogleTest cases: " + ", ".join(f"{count} {status}" for status, count in report["case_counts"].items()),
        f"Baseline: {report.get('baseline', 'not collected')}",
    ]
    if 3 in parts:
        lines.append("Part 3 full TTY startup and service preflight require the dedicated Arch VM trial.")
    if 5 in parts:
        lines.append("Part 5 layout behavior at the real TTY requires the dedicated Arch VM trial.")
    if 6 in parts:
        lines.append("Part 6 live reload and IPC at the real TTY require the dedicated Arch VM trial.")
    for row in report["commands"]:
        lines.append(f"{row['status'].upper()}: {row['id']} — {shlex.join(row['command'])}")
        if row.get("error") or row.get("cleanup_error"):
            lines.append(f"  {row.get('error') or row.get('cleanup_error')}")
        lines.append(f"  Log: {row['log']}")
    for row in report["tests"]:
        lines.append(f"{row['status'].upper()}: {row['test_id']} [part {row.get('part', 1)}; "
                     + ", ".join(row.get("requirement_sections", [])) + "]")
        for case in row.get("cases", []):
            lines.append(f"  {case['status'].upper()}: {case['case_name']}")
            if case.get("reason"):
                lines.append("    " + case["reason"].replace("\n", " "))
        if row.get("reason"):
            lines.append("  " + row["reason"].replace("\n", " "))
    (run_dir / "summary.txt").write_text("\n".join(lines) + "\n")


def positive_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed) or parsed <= 0:
        raise argparse.ArgumentTypeError("must be finite and positive")
    return parsed


def main(argv: list[str] | None = None, *, repository_root: Path | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--build-dir", default="build", help="build directory, relative to the repository root")
    parser.add_argument("--results-dir", default="test-results", help="parent for run-specific evidence directories")
    parser.add_argument("--timeout", type=positive_float, default=300.0, help="deadline in seconds per setup/build/test command")
    parser.add_argument("--log-limit", type=int, default=1024 * 1024, help="maximum retained bytes per command/test log")
    parser.add_argument("--jobs", type=int, help="maximum concurrent compiler jobs and Meson tests")
    parser.add_argument("--suite", action="append", default=[], help="select a Meson suite; repeat to select several")
    args = parser.parse_args(argv)
    if args.log_limit < 1:
        parser.error("--log-limit must be positive")
    if args.jobs is not None and args.jobs < 1:
        parser.error("--jobs must be positive")
    root = (repository_root or Path(__file__).resolve().parent.parent).resolve()
    build_dir = (root / args.build_dir).resolve()
    results_dir = (root / args.results_dir).resolve()
    run_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex[:8]
    run_dir = results_dir / run_id
    run_dir.mkdir(parents=True, mode=0o700)
    report = {
        "v": 2, "parts": [], "run_id": run_id, "started_at": utc_now(),
        "environment": environment_facts(), "commands": [], "tests": [],
        "baseline": str(run_dir / "baseline.json"), "artifacts": [],
    }
    interrupted = None
    previous_term_handler = signal.getsignal(signal.SIGTERM)

    def interrupted_by_signal(signum, _frame):
        raise InterruptedRun(signum)

    signal.signal(signal.SIGTERM, interrupted_by_signal)
    try:
        with tempfile.TemporaryDirectory(prefix="seaside-tests-") as temporary:
            fixture_root = Path(temporary)
            child_env = os.environ.copy()
            for key in list(child_env):
                if key in ("WAYLAND_DISPLAY", "WAYLAND_SOCKET", "DISPLAY", "SEASIDE_SOCKET") or gtest_environment_override(key):
                    child_env.pop(key, None)
            gtest_dir = run_dir / "gtest"
            gtest_dir.mkdir(mode=0o700)
            child_env["GTEST_OUTPUT"] = "xml:" + str(gtest_dir) + "/"
            for key, leaf in (("XDG_RUNTIME_DIR", "runtime"), ("XDG_STATE_HOME", "state"),
                              ("XDG_CONFIG_HOME", "config"), ("TMPDIR", "tmp")):
                directory = fixture_root / leaf
                directory.mkdir(mode=0o700)
                child_env[key] = str(directory)

            def execute(name: str, command: list[str], *, env_override=None, cwd_override=None) -> dict:
                nonlocal interrupted
                row = run_command(command, cwd=cwd_override or root,
                                  log_path=run_dir / f"{name}.log", timeout=args.timeout,
                                  log_limit=args.log_limit,
                                  env=child_env if env_override is None else env_override)
                row["id"] = name
                report["commands"].append(row)
                interrupted = row["interrupted_signal"] or interrupted
                print(f"{name}: {row['status'].upper()} ({row['duration_seconds']:.2f}s)", flush=True)
                return row

            setup = ["meson", "setup"]
            if (build_dir / "meson-private/coredata.dat").is_file():
                setup.append("--reconfigure")
            setup.extend([str(build_dir), str(root)])
            setup.extend(["-Dcpp_std=c++23", "-Dwrap_mode=nodownload"])
            if "--reconfigure" not in setup:
                setup.append("--buildtype=debug")
            configured = execute("configure", setup)
            compiled = None
            if configured["status"] == "pass" and not interrupted:
                compile_command = ["meson", "compile", "-C", str(build_dir)]
                if args.jobs is not None:
                    compile_command.extend(["--jobs", str(args.jobs)])
                compiled = execute("compile", compile_command)
            if not interrupted:
                execute("baseline", [sys.executable, str(root / "tools/record-baseline"), "--build-dir", str(build_dir), "--output", report["baseline"]])
            if compiled is not None and compiled["status"] == "pass" and not interrupted:
                command = ["meson", "test", "-C", str(build_dir), "--no-rebuild", "--print-errorlogs", "--logbase", str(run_dir / "meson")]
                if args.jobs is not None:
                    command.extend(["--num-processes", str(args.jobs)])
                for suite in args.suite:
                    command.extend(["--suite", suite])
                try:
                    manifest = load_test_manifest(build_dir, args.suite)
                    report["parts"] = sorted({row["part"] for row in manifest})
                except (OSError, ValueError, UnicodeError, TypeError) as error:
                    report["tests"] = [collection_failure("meson-test-discovery", str(error))]
                else:
                    report["tests"] = prepare_gtest_discovery(manifest, run_dir, child_env, execute)
                    if not report["tests"] and not interrupted:
                        execute("test", command)
                        report["tests"] = parse_meson_results(run_dir / "meson.json", run_dir, args.log_limit, manifest)
            else:
                report["tests"] = [collection_failure("test-execution", "Setup/build did not pass or the run was interrupted")]
    except (KeyboardInterrupt, InterruptedRun) as error:
        interrupted = error.signum if isinstance(error, InterruptedRun) else signal.SIGINT
        report["tests"].append(collection_failure("test-run-interruption", "Run interrupted"))
    finally:
        signal.signal(signal.SIGTERM, previous_term_handler)
        report["interrupted_signal"] = interrupted
        report["artifacts"] = retain_meson_logs(run_dir, args.log_limit)
        for artifact in report["artifacts"]:
            if artifact.get("error"):
                report["tests"].append(collection_failure("artifact-collection", artifact["error"]))
        write_report(run_dir, report)
        print(f"Report: {run_dir / 'summary.txt'}", flush=True)
    if interrupted:
        return 128 + interrupted
    return {"pass": 0, "fail": 1, "blocked": 2}[report["status"]]


if __name__ == "__main__":
    raise SystemExit(main())
